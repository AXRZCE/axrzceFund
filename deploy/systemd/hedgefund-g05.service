[Unit]
Description=axrzceFund G0.5 broker round-trip drill (on-demand; already passed 2026-06-16)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/hedgefund
# HOME is REQUIRED: git's credential.helper=store reads $HOME/.git-credentials, but the systemd
# service context sets no HOME → the results push would fail with "could not read Username" since
# night_20260702 (Defect-1; docs/incidents/2026-07-02-vm-push-bypass.md, Addendum 2026-07-07).
Environment=HOME=/root
ExecStartPre=/usr/bin/env bash ops/vm_git_sync.sh
ExecStart=/root/hedgefund/.venv/bin/python ops/broker_roundtrip.py
ExecStopPost=/usr/bin/env bash ops/vm_commit_results.sh g05
TimeoutStartSec=1800
# ExecStopPost (the self-healing results push, 3 attempts spaced ~2-3 min)
# must never be killed by the 90s default.
TimeoutStopSec=900
