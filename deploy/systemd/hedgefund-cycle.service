[Unit]
Description=axrzceFund daily dry-run decision cycle (WP6 — orders MODELED, never submitted)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/hedgefund
# HOME is REQUIRED: git's credential.helper=store reads $HOME/.git-credentials, but the systemd
# service context sets no HOME → every nightly push failed with "could not read Username" since
# night_20260702 (Defect-1; docs/incidents/2026-07-02-vm-push-bypass.md, Addendum 2026-07-07).
Environment=HOME=/root
# Self-update to the gated remote head (main) before running — the WP6 PR must therefore be
# MERGED before the timer is enabled (done-criteria R10).
ExecStartPre=/usr/bin/env bash ops/vm_git_sync.sh
ExecStart=/root/hedgefund/.venv/bin/python ops/run_daily_cycle_vm.py
# Commit + push the cycle artifacts (results/wp6/ + fixture locks) even on a fail-closed day —
# the record IS the outcome (R7).
ExecStopPost=/usr/bin/env bash ops/vm_commit_results.sh wp6-cycle
# A hung cycle self-heals; the resulting gap is a MISSED/failed record, never a silent skip (R6).
TimeoutStartSec=2700
# ExecStopPost (the self-healing results push, 3 attempts spaced ~2-3 min)
# must never be killed by the 90s default.
TimeoutStopSec=900
